{
  "name": "imai-study",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4178",
    "validate:curriculum": "tsx scripts/validate-curriculum.ts",
    "validate:library": "tsx scripts/validate-library.ts",
    "build:challenge-bank": "tsx scripts/generate-challenge-bank.ts",
    "bootstrap:super-admin": "node server/dist/bootstrapSuperAdmin.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.1",
    "lucide-react": "^1.41.0",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.0"
  }
}
